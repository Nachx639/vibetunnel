+// V8 removed String::WriteUtf8 (Node 24+); copy through Nan::Utf8String, always NUL-terminated.
+static void copyUtf8(v8::Local<v8::String> value, char* buffer, size_t size) {
+	Nan::Utf8String utf8(value);
+	size_t length = static_cast<size_t>(utf8.length());
+	if (length > size - 1) length = size - 1;
+	memcpy(buffer, *utf8, length);
+	buffer[length] = '\0';
+}
