{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "types": ["node"],
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.server.tsbuildinfo",
    "inlineSourceMap": true,
    "inlineSources": true
  },
  "files": [
    "src/client/i18n/locales/en.ts",
    "src/client/i18n/locales/ar.ts",
    "src/client/i18n/locales/bn.ts",
    "src/client/i18n/locales/es.ts",
    "src/client/i18n/locales/fr.ts",
    "src/client/i18n/locales/hi.ts",
    "src/client/i18n/locales/pt-BR.ts",
    "src/client/i18n/locales/zh-CN.ts"
  ],
  "include": [
    "src/server/**/*",
    "src/shared/**/*",
    "src/types/**/*",
    "src/cli.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "public",
    "src/client/**/*",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
